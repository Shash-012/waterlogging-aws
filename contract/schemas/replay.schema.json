{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replay",
  "description": "GET /replays/{event_id}. Every frame is a Snapshot with mode \"replay\".",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "title_en",
    "kind",
    "start",
    "end",
    "frame_count",
    "frames",
    "ground_truth",
    "metrics"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date of the storm's main rain (YYYY-MM-DD)."
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "storm",
        "dry"
      ]
    },
    "start": {
      "$ref": "common.schema.json#/$defs/utc_time"
    },
    "end": {
      "$ref": "common.schema.json#/$defs/utc_time"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "snapshot.schema.json"
          },
          {
            "properties": {
              "mode": {
                "const": "replay"
              }
            }
          }
        ]
      }
    },
    "ground_truth": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "title": "GroundTruthReport",
        "required": [
          "hotspot_id",
          "first_report_at",
          "source_url",
          "note"
        ],
        "properties": {
          "hotspot_id": {
            "$ref": "common.schema.json#/$defs/hotspot_id"
          },
          "first_report_at": {
            "$ref": "common.schema.json#/$defs/utc_time"
          },
          "source_url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "note": {
            "type": "string"
          },
          "time_kind": {
            "type": "string",
            "enum": [
              "post",
              "stated",
              "published"
            ],
            "description": "Optional. What kind of time first_report_at is; with published, lead times are upper bounds."
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "title": "ReplayMetrics",
      "required": [
        "spots_reported",
        "flagged_before_report",
        "median_lead_hours",
        "unconfirmed_flags"
      ],
      "properties": {
        "spots_reported": {
          "type": "integer",
          "minimum": 0
        },
        "flagged_before_report": {
          "type": "integer",
          "minimum": 0
        },
        "median_lead_hours": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "null when no reported spot was flagged before its report."
        },
        "unconfirmed_flags": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
