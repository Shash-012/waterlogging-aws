{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hotspot",
  "description": "One waterlogging hotspot, from GET /hotspots and GET /hotspots/{id}.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hotspot_id",
    "name_en",
    "name_hi",
    "lat",
    "lon",
    "site_type",
    "ward",
    "importance",
    "elevation_m",
    "relative_depth_m",
    "catchment_km2",
    "flood_seasons",
    "factors",
    "susceptibility",
    "avoid_en",
    "avoid_hi",
    "diversion_en",
    "diversion_hi",
    "sources"
  ],
  "properties": {
    "hotspot_id": {
      "$ref": "common.schema.json#/$defs/hotspot_id"
    },
    "name_en": {
      "type": "string",
      "minLength": 1
    },
    "name_hi": {
      "type": "string",
      "minLength": 1
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "site_type": {
      "$ref": "common.schema.json#/$defs/site_type"
    },
    "ward": {
      "type": [
        "string",
        "null"
      ]
    },
    "importance": {
      "type": "number",
      "enum": [
        1.0,
        0.6,
        0.3
      ],
      "description": "1.0 arterial/emergency route, 0.6 major road, 0.3 local road. Pump tie-breaker only."
    },
    "elevation_m": {
      "type": "number"
    },
    "relative_depth_m": {
      "type": "number",
      "description": "d in the LowLying definition (m)."
    },
    "catchment_km2": {
      "$ref": "common.schema.json#/$defs/non_negative"
    },
    "flood_seasons": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "factors": {
      "type": "object",
      "additionalProperties": false,
      "title": "HotspotFactors",
      "required": [
        "history",
        "low_lying",
        "catchment"
      ],
      "properties": {
        "history": {
          "$ref": "common.schema.json#/$defs/score"
        },
        "low_lying": {
          "$ref": "common.schema.json#/$defs/score"
        },
        "catchment": {
          "$ref": "common.schema.json#/$defs/score"
        }
      }
    },
    "susceptibility": {
      "$ref": "common.schema.json#/$defs/score"
    },
    "avoid_en": {
      "type": "string"
    },
    "avoid_hi": {
      "type": "string"
    },
    "diversion_en": {
      "type": "string"
    },
    "diversion_hi": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/url"
      }
    }
  }
}
