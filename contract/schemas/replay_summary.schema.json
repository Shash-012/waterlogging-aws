{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplaySummary",
  "description": "One entry of GET /replays: a Replay without frames, ground_truth and metrics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "title_en",
    "kind",
    "start",
    "end",
    "frame_count"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "title_en": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "storm",
        "dry"
      ]
    },
    "start": {
      "$ref": "common.schema.json#/$defs/utc_time"
    },
    "end": {
      "$ref": "common.schema.json#/$defs/utc_time"
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    }
  }
}
