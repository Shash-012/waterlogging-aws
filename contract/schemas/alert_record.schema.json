{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertRecord",
  "description": "One alert in the log: the request fields, the response fields and sent_by.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hotspot_id",
    "run_id",
    "mode",
    "level",
    "risk",
    "peak_at",
    "alert_id",
    "sent_at",
    "duplicate",
    "text_en",
    "text_hi",
    "deliveries",
    "sent_by"
  ],
  "properties": {
    "hotspot_id": {
      "$ref": "common.schema.json#/$defs/hotspot_id"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/utc_time"
    },
    "mode": {
      "$ref": "common.schema.json#/$defs/mode"
    },
    "event_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Replay event_id; required when mode is replay, null for live."
    },
    "level": {
      "$ref": "common.schema.json#/$defs/level"
    },
    "risk": {
      "$ref": "common.schema.json#/$defs/score"
    },
    "peak_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/utc_time"
        },
        {
          "type": "null"
        }
      ]
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "sent_at": {
      "$ref": "common.schema.json#/$defs/utc_time"
    },
    "duplicate": {
      "type": "boolean"
    },
    "text_en": {
      "type": "string"
    },
    "text_hi": {
      "type": "string"
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "title": "AlertDelivery",
        "required": [
          "group",
          "ok"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "sent_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "if": {
    "properties": {
      "mode": {
        "const": "replay"
      }
    },
    "required": [
      "mode"
    ]
  },
  "then": {
    "required": [
      "event_id"
    ],
    "properties": {
      "event_id": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
