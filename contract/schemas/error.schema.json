{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error",
  "description": "Error body returned with any non-2xx HTTP status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "title": "ErrorDetail",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
